# Copy this file to ".env" and put the address of YOUR API server.
# The phone must be able to reach it (same Wi-Fi). On a phone, "localhost" is the phone itself:
# use your computer's LAN address, e.g. http://192.168.1.20:3000 (the server prints it at startup).
# Leave the value empty to use the app offline only.
# After changing .env, restart Expo with: npx expo start -c
EXPO_PUBLIC_API_URL=http://<YOUR_PC_LAN_IP>:3000
